NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Product display name (API index `/`, OpenAPI title, Better Auth, default EMAIL_FROM)
APP_NAME=Elysia Starter

# --- Database: Postgres only ---
# Required for app/seed (tests use in-memory PGlite via NODE_ENV=test — no URL needed).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Force PGlite outside test (optional): USE_PGLITE=true

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Browser / SPA origins allowed for cookie sessions + Better Auth CSRF/origin checks (comma-separated)
TRUSTED_ORIGINS=http://localhost:3000
# Base URL for email links (password reset, verification). Defaults to BETTER_AUTH_URL.
APP_URL=http://localhost:3000
TRUST_PROXY=false

# Rate limiting (Elysia security plugin + Better Auth). Default off.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# HTTP access log (structured console). Off in tests; set false to silence elsewhere.
# ACCESS_LOG=false

# Bun serve limits (applied via Elysia `{ serve }`)
# Prefer MiB. Legacy MAX_BODY_SIZE=<bytes> still works if MAX_BODY_SIZE_MIB is unset.
MAX_BODY_SIZE_MIB=1
IDLE_TIMEOUT=30

# Cluster — see https://elysiajs.com/patterns/deploy.html
# 0 = single process (dev/test); auto = os.availableParallelism(); N = N workers
# SO_REUSEPORT multi-listen is reliable on Linux only.
CLUSTER_WORKERS=0
# RUN_MIGRATIONS=true

# Cron (@elysia/cron). Default off. Under cluster, jobs run on primary only.
CRON_ENABLED=false
# Escape hatch: set ENABLE_CRON=true on exactly one worker fork instead of primary.

# API docs — Scalar `/docs` + Better Auth `/api/auth/reference` (one switch for both)
# Unset → enabled when NODE_ENV is not production; set true/false to override.
# DOCS_ENABLED=true
# HTTP Basic Auth for /docs and /api/auth/reference (placeholders — change in real deploys).
# Both required together. In production, DOCS_ENABLED=true without both → boot fails.
# In development, missing credentials → warning and public docs.
DOCS_BASIC_AUTH_USER=docs
DOCS_BASIC_AUTH_PASSWORD=change-me

# Seed accounts (bun run seed)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
USER_NAME=Demo User
USER_EMAIL=user@example.com
USER_PASSWORD=ChangeMe123!

# Email — unset SMTP_HOST → console mock; set SMTP_* to send via any SMTP server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_REJECT_UNAUTHORIZED=false
EMAIL_FROM=Elysia Starter <noreply@localhost>
# REQUIRE_EMAIL_VERIFICATION=true

# --- Auth providers (toggles + credentials; empty secrets → provider stays off) ---
# Google OAuth — needs AUTH_GOOGLE_ENABLED=true AND both credentials
AUTH_GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# One Tap (FedCM) — also needs AUTH_GOOGLE_ENABLED + credentials
AUTH_GOOGLE_ONE_TAP_ENABLED=false
# Google Cloud Console authorized redirect URI (also under GET /api/auth/providers google.*):
#   {BETTER_AUTH_URL}/api/auth/callback/google

# Enterprise SSO via Better Auth official plugin (@better-auth/sso)
# Docs: https://better-auth.com/docs/plugins/sso
# Prefer AUTH_SSO_*; AUTH_OIDC_* is still read as a silent fallback if AUTH_SSO_* is unset.
AUTH_SSO_ENABLED=false
AUTH_SSO_PROVIDER_ID=oidc
AUTH_SSO_NAME=SSO
# Email domain for provider matching (comma-separated domains allowed)
AUTH_SSO_DOMAIN=localhost
# AUTH_SSO_CLIENT_ID=
# AUTH_SSO_CLIENT_SECRET=
# OIDC issuer (required). Discovery URL can supply issuer if AUTH_SSO_ISSUER is unset.
# AUTH_SSO_ISSUER=https://idp.example.com
# Issuer or full discovery URL (issuer gets `/.well-known/openid-configuration` appended)
# AUTH_SSO_DISCOVERY_URL=https://idp.example.com
# Optional overrides when discovery is incomplete:
# AUTH_SSO_AUTHORIZATION_URL=
# AUTH_SSO_TOKEN_URL=
# AUTH_SSO_USERINFO_URL=
# AUTH_SSO_JWKS_URL=
AUTH_SSO_SCOPES=openid profile email
# IdP registration URIs (also returned by GET /api/auth/providers under sso.*):
#   redirect/callback: {BETTER_AUTH_URL}/api/auth/sso/callback/{AUTH_SSO_PROVIDER_ID}
#   sign-in:           POST {BETTER_AUTH_URL}/api/auth/sign-in/sso
#   sign-out:          POST {BETTER_AUTH_URL}/api/auth/sign-out
# Add the IdP issuer origin to TRUSTED_ORIGINS (auto-appended from AUTH_SSO_ISSUER when possible).

# --- Captcha (Better Auth official plugin; default off) ---
# Docs: https://better-auth.com/docs/plugins/captcha
# When enabled, clients must send header `x-captcha-response` on:
#   POST /api/auth/sign-up/email
#   POST /api/auth/sign-in/email
#   POST /api/auth/request-password-reset
# CAPTCHA_ENABLED=false
# Provider: cloudflare-turnstile | google-recaptcha | hcaptcha | captchafox
# (vercel-botid needs the botid SDK — not wired via env in this starter)
# CAPTCHA_PROVIDER=cloudflare-turnstile
# CAPTCHA_SECRET_KEY=
# Public site key for SPA widgets (also returned by GET /api/auth/providers when enabled)
# CAPTCHA_SITE_KEY=
# Optional reCAPTCHA v3 score threshold (0–1; plugin default 0.5)
# CAPTCHA_MIN_SCORE=0.5

# Locale / i18n — API negotiation (en, id)
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,id

# --- File storage (shared service: local disk OR S3 via Bun.S3Client) ---
# Import getStorage() from src/lib/storage in any module — same API for both drivers.
# Example: POST /api/users/me/avatar → storage.put() → user.image = url
# Bun S3Client is provider-agnostic: set S3_ENDPOINT for any S3-compatible API
# (AWS, MinIO, Wasabi, RustFS, R2, Spaces, …). Leave S3_ENDPOINT empty for AWS default.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=storage
# Optional key prefix for both drivers (no leading/trailing slash needed)
# STORAGE_PREFIX=uploads
# Override public URL base (default local: {APP_URL}/uploads — served by plugin.storage-static)
# STORAGE_PUBLIC_URL=

# --- S3-compatible (STORAGE_DRIVER=s3) — pick one provider block ---
# Shared keys (required for s3):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=
# S3_PRESIGN_EXPIRES=3600
# S3_FORCE_PATH_STYLE=true

# AWS S3 — omit S3_ENDPOINT (Bun infers from region + bucket)
# S3_REGION=us-east-1
# # S3_ENDPOINT=
# # S3_FORCE_PATH_STYLE=false   # optional: virtual-hosted bucket.s3.region.amazonaws.com

# MinIO (local / self-hosted)
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# Wasabi
# S3_ENDPOINT=https://s3.wasabisys.com
# # or regional: https://s3.ap-northeast-1.wasabisys.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# RustFS (S3-compatible self-hosted)
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# Tip: raise MAX_BODY_SIZE_MIB for large uploads (default 1; avatar route allows 2 MiB).
