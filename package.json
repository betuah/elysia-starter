{
  "name": "elysia-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Elysia starter with Better Auth, role-based access control, and OpenAPI docs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "bun run src/scripts/seed.ts"
  },
  "dependencies": {
    "@better-auth/sso": "^1.7.10",
    "@electric-sql/pglite": "^0.5.10",
    "@elysia/cors": "^1.4.2",
    "@elysia/cron": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
